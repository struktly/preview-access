{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "struktly-preview-access",
  "account_id": "9693f3d71030a9384e5fd9e528ab0e0b",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "struktly-website-access",
      "database_id": "f385b714-cc84-4726-a728-e217e5bfb92f",
      "remote": true
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "struktly-preview-releases"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "struktly.cloudflareaccess.com",
    "ACCESS_AUD": "2a7245b9ccfdec5c9ff0dde391a528dd64a62f3e0cd86987ae4ace26efe87544",
    "NOTIFICATION_FROM": "preview@struktly.app"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
