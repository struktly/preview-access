{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "struktly-preview-access-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "preview-access-test"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "preview-access-test"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "test.cloudflareaccess.com",
    "ACCESS_AUD": "test-audience",
    "NOTIFICATION_FROM": "preview@test.example"
  }
}
